# ==============================================================================
# Tuned Voice Changer — Colab Deployment Configuration Template
# ==============================================================================
# Copy this file to config.env (or pass variables via environment) to override
# default paths, repository revision, or server startup parameters.
# ==============================================================================

# --- 1. Source Repository Layer ---
REPOSITORY_URL="https://github.com/Zeesat/tuned-voice-changer.git"
REPOSITORY_REF="master"
# Optional: For private GitHub repositories, pass GITHUB_TOKEN via environment (never commit tokens)
# GITHUB_TOKEN=""

# --- 2. Colab Ephemeral Execution Layer (Local SSD — Never on Google Drive) ---
COLAB_WORKSPACE_DIR="/content/voice-changer"
VC_ENV_DIR="/content/vc_env"
VC_PID_FILE="/content/vc_server.pid"
VC_LOG_FILE="/content/vc_server.log"

# --- 3. Google Drive Persistence Layer ---
DRIVE_MOUNT_DIR="/content/drive/MyDrive"
DRIVE_PERSIST_DIR="/content/drive/MyDrive/VoiceChanger"

# --- 4. Server Networking & Runtime Options ---
# Bind to 127.0.0.1 for private access via SSH LocalForward (never expose publicly)
VC_HOST="127.0.0.1"
VC_PORT="18888"
VC_HTTPS="False"
VC_LOG_LEVEL="error"
# Set to "" to disable automatic download of the 4 upstream sample models;
# set to "production" if you want upstream sample models downloaded into model_dir.
VC_SAMPLE_MODE=""
VC_CONTENT_VEC_ONNX_ON="True"

# --- 5. Default Slot 0 Custom Model (Optional Auto-Provisioning) ---
# If AUTO_PROVISION_SLOT0="true" and Slot 0 is empty on Google Drive,
# prepare_workspace.sh will populate Slot 0 from the specified Google Drive ID or backup URL.
AUTO_PROVISION_SLOT0="true"
SLOT0_NAME="Vestia Zeta (RVC v2)"
SLOT0_GDRIVE_ID="1JqrPD4d8lF2QdSH_S4Q-z8ySBlNn1EOP"
SLOT0_BACKUP_URL="https://huggingface.co/megaaziib/my-rvc-models-collection/resolve/main/zeta.zip"
SLOT0_SAMPLING_RATE="48000"
SLOT0_EMB_CHANNELS="768"
SLOT0_EMB_OUTPUT_LAYER="12"
SLOT0_F0="true"
SLOT0_EMBEDDER="hubert_base"
